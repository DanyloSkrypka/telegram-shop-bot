# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
BOT_TOKEN=

# Telegram user IDs that receive order alerts and can use /admin (comma separated)
ADMIN_IDS=

# stars    -> Telegram Stars (XTR), works without a payment provider
# provider -> card payments via a provider token from BotFather (use the TEST token for demos)
PAYMENT_MODE=stars
PROVIDER_TOKEN=
CURRENCY=EUR

# Optional: enables AI answers via Claude. Without it the bot uses built-in template answers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

SHOP_NAME=Nordic Roast
DB_PATH=data/shop.db
